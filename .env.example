DATABASE_URL=postgresql+psycopg://smartroute:smartroute@db:5432/smartroute
JWT_SECRET=replace-with-a-random-secret
KEY_VAULT_MASTER_KEY=
OLLAMA_URL=http://ollama:11434
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
PRIVACY_GATE_REQUIRED=true
# PII detector: patterns (regex only) | piiranha (local transformer + regex; pip install -e ".[pii]")
PII_DETECTOR=patterns
PII_MODEL_PATH=
PII_THRESHOLD=0.5
PII_IGNORE_TYPES=
PII_DEVICE=auto
